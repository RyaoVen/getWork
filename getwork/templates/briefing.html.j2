<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "Segoe UI", "Microsoft YaHei", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
    background: #ffffff;
    color: #1f2329;
    line-height: 1.6;
    padding: 32px 40px 48px;
    max-width: 800px;
    margin: 0 auto;
    font-size: 14px;
  }
  h1 { font-size: 24px; font-weight: 700; color: #111; margin-bottom: 4px; }
  .meta { color: #8a919f; font-size: 12px; margin-bottom: 24px; }
  h2 { font-size: 18px; font-weight: 600; margin: 28px 0 12px; padding-bottom: 6px; border-bottom: 2px solid #eef0f4; color: #24292f; }
  h3 { font-size: 15px; font-weight: 600; margin: 18px 0 8px; color: #24292f; }
  p { margin: 8px 0; }
  ul, ol { padding-left: 22px; margin: 8px 0; }
  li { margin: 4px 0; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0; font-size: 13px; }
  th, td { border: 1px solid #e2e5ea; padding: 8px 10px; text-align: left; vertical-align: top; }
  th { background: #f6f8fa; font-weight: 600; white-space: nowrap; }
  tr:nth-child(even) td { background: #fafbfc; }
  a { color: #0969da; text-decoration: none; }
  a:hover { text-decoration: underline; }
  code { background: #f6f8fa; padding: 1px 5px; border-radius: 4px; font-family: "SFMono-Regular", Consolas, monospace; font-size: 12px; }
  pre { background: #f6f8fa; padding: 12px 14px; border-radius: 6px; overflow-x: auto; margin: 10px 0; }
  pre code { background: none; padding: 0; }
  blockquote { border-left: 3px solid #d0d7de; padding-left: 12px; color: #57606a; margin: 10px 0; }
  .tag { display: inline-block; background: #ddf4ff; color: #0969da; border-radius: 4px; padding: 0 6px; font-size: 12px; margin-right: 6px; }
</style>
</head>
<body>
  <h1>{{ title }}</h1>
  <div class="meta">生成时间：{{ generated_at }}</div>
  {{ body | safe }}
</body>
</html>
